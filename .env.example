# Copy thanh .env (da gitignore) va dien gia tri that. KHONG commit .env.
# Sinh secret:  python -c "import secrets; print(secrets.token_hex(32))"

APP_ENV=development            # staging/production bat buoc JWT_SECRET + INTERNAL_API_KEY that
JWT_SECRET=
INTERNAL_API_KEY=
ALLOWED_ORIGINS=http://localhost:3000

DATABASE_URL=sqlite:///./fraud_platform.db
REDIS_HOST=localhost
REDIS_PORT=6379
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# docker-compose
POSTGRES_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# Seed 3 tai khoan demo (backend/scripts/seed_and_train.py)
DEMO_PASSWORD=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_DEMO_MODE=false     # true chi khi demo local; khi do dat them NEXT_PUBLIC_DEMO_PASSWORD (= DEMO_PASSWORD)
